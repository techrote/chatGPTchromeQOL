{
  "manifest_version": 3,
  "name": "ChatGPT Response Completion Watch",
  "version": "0.1.0",
  "description": "Prototype desktop notification when a ChatGPT response finishes while the tab is not active.",
  "permissions": ["notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "icons": {
    "128": "icon.svg"
  }
}
