{
  "manifest_version": 3,
  "name": "ChatGPT Pro Message Counter",
  "version": "0.1.0",
  "description": "Prototype local counter for ChatGPT Pro-model sends.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
